# Copy this file to .env.test and fill in the MyDog CI Test project's keys.
# NEVER put production keys here. The CI Test project is a fully isolated
# Supabase project used only for automated tests — see
# docs/implementation/phase-0-1-plan.md for how it was created.

# Safe to share within the team (a public/anon-scoped key), but still not
# committed as a real value — this file only ever holds the placeholder below.
TEST_SUPABASE_URL=https://zzkudljlyvkjfkjwamcn.supabase.co
TEST_SUPABASE_ANON_KEY=replace-with-the-ci-test-project-anon-key

# Secret. Used ONLY by tests/fixtures/adminFixture.ts and test cleanup helpers
# to bypass RLS for fixture bootstrap and teardown within the isolated CI Test
# project. In CI this is injected as a GitHub Actions secret, never committed.
TEST_SUPABASE_SERVICE_ROLE_KEY=replace-with-the-ci-test-project-service-role-key
